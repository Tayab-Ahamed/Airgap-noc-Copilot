# Copy to .env and adjust. Nothing here should point outside the air-gap.
NOC_HOST=0.0.0.0
NOC_PORT=8000
NOC_LOG_LEVEL=INFO
NOC_LOG_JSON=true

# Set a strong key in production; leave empty to disable auth in dev.
NOC_API_KEY=

MODEL_DIR=models/
INDEX_DIR=data/faiss_index
NOC_DB_PATH=data/noc.db

STREAM_INTERVAL=5
NOC_WINDOW=30

# LLM (must be local/internal only)
USE_OLLAMA=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# containerlab
CLAB_PREFIX=clab-airgap-noc
DRY_RUN=1
